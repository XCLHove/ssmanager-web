# ssmanager-web API 环境变量示例。
# 复制为 .env 后按需修改；所有变量均可省略（省略时读 config.json，再退回内置默认值）。
# 优先级：环境变量 > config.json > 内置默认值
# 配置文件路径由命令行 -c/--config 指定（默认 <root>/config.json），不通过环境变量配置。

# ---- 登录账户 ----
#SSMANAGER_WEB_USERNAME=admin
#SSMANAGER_WEB_PASSWORD=admin123

# ---- ssmanager（shadowsocks-rust ssmanager）地址 ----
# UDP：host:port，支持 127.0.0.1:6100、localhost:6100、[::1]:6100；省略端口默认 6100。
#SSMANAGER_ADDRESS=127.0.0.1:6100
# Unix datagram socket：unix:/path、unix:///path，或以 /、./、../ 开头的裸路径。
# 需构建产物包含 unix-dgram（见 README「单文件部署」）。
#SSMANAGER_ADDRESS=unix:/run/ssmanager.sock

# ---- Web 服务 ----
#SSMANAGER_WEB_PORT=3000
#SSMANAGER_WEB_HOST=0.0.0.0

# ---- 客户端地址 / 订阅 ----
# 客户端连接使用的公网主机（端口沿用服务器端口）
#SSMANAGER_PUBLIC_HOST=127.0.0.1
# 订阅绝对 URL 的基础地址，例如 https://panel.example.com（可空，空则使用请求 Host）
#SSMANAGER_PUBLIC_BASE_URL=

# ---- 登录会话 ----
# 会话有效期（支持 ms/s/m/h/d，如 12h）。会话只存内存，进程重启后失效。
#SSMANAGER_WEB_TOKEN_TTL=12h
# 登录协议：先 POST /api/auth/public-key 获取 60 秒有效的 RSA 公钥（kid），
# 再用该公钥加密 {username, password(MD5), sessionKey(32B Base64)} 后 POST /api/auth/login。
# 公钥池的 60s 有效期 / 10s 复用窗口 / 上限 8 为代码内常量，不可通过环境变量配置。

# ---- 本地数据 ----
# SQLite 数据目录（相对路径基于根目录，支持绝对路径）。DB 文件名固定 ssmanager-web.db。
#SSMANAGER_DATA_DIR=data
# 配置与数据根目录（源码默认 api/，打包默认 dist/ 的上一级；单文件部署可自定义）
#SSMANAGER_ROOT=
# 前端静态资源目录（默认 <root>/../ui/dist）
#SSMANAGER_UI_DIR=

# ---- 其他 ----
# 与 ssmanager 通信超时（毫秒）
#SSMANAGER_TIMEOUT_MS=3000
