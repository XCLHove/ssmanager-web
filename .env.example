# Docker Compose 环境变量示例：复制为 .env 后修改（.env 已 gitignore）

# Web 登录账户
SSMANAGER_WEB_USERNAME=admin
SSMANAGER_WEB_PASSWORD=change-me

# ssmanager 地址（宿主机运行 ssmanager 时使用 host.docker.internal）
# UDP：host:port；Unix socket：unix:/run/ssmanager.sock（需挂载 socket）
SSMANAGER_ADDRESS=host.docker.internal:6100

# 客户端连接使用的公网主机（端口沿用服务器端口）
SSMANAGER_PUBLIC_HOST=127.0.0.1

# 订阅绝对 URL 的基础地址，例如 https://panel.example.com（可留空）
SSMANAGER_PUBLIC_BASE_URL=

# 宿主机映射到容器 3000 的端口
WEB_PORT=3000
